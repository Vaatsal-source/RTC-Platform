# ── Shared ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
MONGO_URI=mongodb://127.0.0.1:27017/syncgrid
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-in-production-please-use-32+chars
JWT_EXPIRES_IN=7d

# ── API ─────────────────────────────────────────────────
API_PORT=5000
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
APP_URL=http://localhost:5173

# ── WebSocket server ────────────────────────────────────
WS_PORT=8080

# ── Worker / Email (leave SMTP_HOST empty to log emails instead of sending) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SyncGrid <no-reply@syncgrid.local>"
WORKER_METRICS_PORT=9102

# ── Web (Vite) ──────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:8080
