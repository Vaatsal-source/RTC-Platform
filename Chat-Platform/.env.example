# ── Shared ──────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
MONGO_URI=mongodb://127.0.0.1:27017/syncgrid
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-in-production-please-use-32+chars
JWT_EXPIRES_IN=1h            # access token; the refresh token (REFRESH_TOKEN_DAYS) renews it silently
REFRESH_TOKEN_DAYS=30

# ── API ─────────────────────────────────────────────────
API_PORT=5000
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
AUTH_RATE_LIMIT=30           # login/register/reset attempts per IP per 15 min (raise for tests or big shared networks)
TRUST_PROXY=0                # set to 1 behind Caddy / Cloudflare Tunnel so rate limits see real client IPs

# Optional S3-compatible file storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO). Empty bucket = local disk.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=10
APP_URL=http://localhost:5173

# ── WebSocket server ────────────────────────────────────
WS_PORT=8080

# ── Worker / Email (leave SMTP_HOST empty to log emails instead of sending) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SyncGrid <no-reply@syncgrid.local>"
WORKER_METRICS_PORT=9102

# ── Docker Compose only (docker-compose.yml) ───────────────
# Use hex secrets:  openssl rand -hex 24
MONGO_USER=syncgrid
MONGO_PASSWORD=
REDIS_PASSWORD=
GRAFANA_PASSWORD=
# Reverse proxy (--profile proxy): your domain (auto HTTPS), or :80 behind a tunnel / other TLS terminator
DOMAIN=
# Cloudflare Tunnel (--profile tunnel)
TUNNEL_TOKEN=
# Bind published ports to 127.0.0.1 when the proxy is the only public entrance
BIND_ADDR=0.0.0.0

# ── Web (Vite) ──────────────────────────────────────
# Local: absolute URLs.  Behind the proxy: VITE_API_URL=/api and VITE_WS_URL=/ws (same origin)
VITE_API_URL=http://localhost:5000/api
VITE_WS_URL=ws://localhost:8080
